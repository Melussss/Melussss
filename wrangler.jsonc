{
  "name": "digitron-computers",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digitron-store",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  
